# Browser-visible Convex deployment URL. `npx convex dev` creates CONVEX_URL
# locally; copy its value here as PUBLIC_CONVEX_URL when testing the browser.
PUBLIC_CONVEX_URL=

# Clerk's Frontend API URL, configured in Clerk's Convex integration. This is
# read only by Convex when it deploys its JWT authentication provider.
CLERK_JWT_ISSUER_DOMAIN=
