---
// PROTOTYPE — THROWAWAY. Three variants of the Override player + administration
// journeys, switchable via `?variant=`, with `?role=` for the signed-out / player /
// sprite-admin states. Answers "Validate player and administration journeys" (#26).
// Dev only; never rendered in a production build.
import PrototypeSwitcher from '../../components/prototype/override-journeys/PrototypeSwitcher.astro';
import VariantA from '../../components/prototype/override-journeys/VariantA.astro';
import VariantB from '../../components/prototype/override-journeys/VariantB.astro';
import VariantC from '../../components/prototype/override-journeys/VariantC.astro';
import VariantD from '../../components/prototype/override-journeys/VariantD.astro';

if (!import.meta.env.DEV) return Astro.redirect('/');

const names: Record<string, string> = {
  A: 'Season hub — one surface, admin is a mode',
  B: 'Library shell — sidebar destinations, admin is a room',
  C: 'Mission control — progress first, admin is a back office',
  D: 'Hybrid — A\u2019s season hub + C\u2019s back office'
};

const params = Astro.url.searchParams;
const variant = names[params.get('variant') ?? ''] ? (params.get('variant') as string) : 'A';
const role = (params.get('role') ?? 'player') as 'anon' | 'player' | 'admin';
const pane = params.get('pane') ?? '';
const filter = params.get('filter') ?? '';
const editing = params.get('editing') === '1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>PROTOTYPE · Override journeys · variant {variant}</title>
  </head>
  <body>
    {variant === 'A' && <VariantA role={role} editing={editing} />}
    {variant === 'B' && <VariantB role={role} pane={pane} />}
    {variant === 'C' && <VariantC role={role} pane={pane} filter={filter} />}
    {variant === 'D' && <VariantD role={role} pane={pane} />}
    <PrototypeSwitcher current={variant} names={names} role={role} />
  </body>
</html>

<style is:global>
  @font-face {
    font-display: swap;
    font-family: "Burbank Big Condensed";
    font-style: normal;
    font-weight: 900;
    src: url("/fonts/burbank-big-condensed-black.otf") format("opentype");
  }

  :root {
    color-scheme: dark;
    --bg: #070b24;
    --panel: #121a4a;
    --panel-2: #1d2f77;
    --text: #ffffff;
    --muted: #c8d6ff;
    --line: #3658d8;
    --green: #37f58f;
    --blue: #28d7ff;
    --gold: #ffe34d;
    --violet: #9f5cff;
    --pink: #ff4fd8;
    --shadow: rgba(0, 0, 0, 0.38);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 18% 12%, rgba(255, 227, 77, 0.24), transparent 16rem),
      radial-gradient(circle at 84% 8%, rgba(255, 79, 216, 0.22), transparent 18rem),
      linear-gradient(145deg, #070b24 0%, #162b88 46%, #5e2fd6 100%);
    color: var(--text);
    font-family: "Burbank Big Condensed", Impact, Inter, ui-sans-serif, system-ui, sans-serif;
  }

  button, input, select { font: inherit; }
</style>
