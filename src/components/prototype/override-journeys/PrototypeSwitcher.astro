---
// PROTOTYPE — floating switcher. Deliberately styled to look nothing like the page
// it sits on. Never rendered outside `astro dev`.
interface Props {
  current: string;
  names: Record<string, string>;
  role: string;
}

const { current, names, role } = Astro.props;
const keys = Object.keys(names);
const index = keys.indexOf(current);
const prev = keys[(index - 1 + keys.length) % keys.length];
const next = keys[(index + 1) % keys.length];

const to = (variant: string, nextRole: string) => `?variant=${variant}&role=${nextRole}`;

const roles = [
  { id: 'anon', label: 'Signed out' },
  { id: 'player', label: 'Player' },
  { id: 'admin', label: 'Admin' }
];
---

<div class="switcher" data-prev={to(prev, role)} data-next={to(next, role)}>
  <a class="arrow" href={to(prev, role)} aria-label="Previous variant">←</a>
  <span class="label"><b>{current}</b> — {names[current]}</span>
  <a class="arrow" href={to(next, role)} aria-label="Next variant">→</a>
  <span class="divider"></span>
  <span class="role-label">Role</span>
  {roles.map((item) => (
    <a class:list={['role', { on: role === item.id }]} href={to(current, item.id)}>{item.label}</a>
  ))}
</div>

<script>
  const bar = document.querySelector('.switcher');
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    if (target && (target.closest('input, textarea, [contenteditable]'))) return;
    if (event.key === 'ArrowLeft') location.search = bar?.getAttribute('data-prev') ?? '';
    if (event.key === 'ArrowRight') location.search = bar?.getAttribute('data-next') ?? '';
  });
</script>

<style>
  .switcher {
    position: fixed;
    bottom: 18px;
    left: 50%;
    z-index: 999;
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px 14px;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    color: #101322;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    transform: translateX(-50%);
  }

  .arrow {
    display: grid;
    place-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #101322;
    color: #fff;
    text-decoration: none;
  }

  .label { min-width: 190px; text-align: center; }
  .divider { width: 1px; height: 22px; background: #d4d8e4; }
  .role-label { color: #6b7490; font-size: 0.7rem; text-transform: uppercase; }

  .role {
    border-radius: 999px;
    padding: 4px 10px;
    background: #eef0f6;
    color: #101322;
    text-decoration: none;
  }

  .role.on { background: #2f57d8; color: #fff; }
</style>
